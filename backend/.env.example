# Pass with uvicorn --env-file backend/.env; never commit local .env.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=28800
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared LLM client: custom (default, optional endpoint) or gemini.
# Copy these settings into backend/.env and replace placeholders locally.
# RECEIPT_LLM_PROVIDER=gemini
# RECEIPT_LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# RECEIPT_LLM_API_KEY=<your-Gemini-API-key>
# RECEIPT_LLM_MODEL=<model-ID-verified-with-your-key>
# Custom service: RECEIPT_LLM_PROVIDER=custom; set its endpoint and optional bearer key.
# Without a configured service compilation stays unavailable; the active policy is retained.
# Worker-only model locations; never required to run the web application:
# RECEIPT_LAYOUTLM_MODEL=/worker/models/layoutlm/best
# RECEIPT_LAYOUTLM_METRICS=/worker/repo/data/models/layoutlm_metrics.json
# RECEIPT_CNN_MODEL=/worker/models/fake_cnn/best_model.pt
# RECEIPT_CNN_METRICS=/worker/repo/data/models/fake_cnn_metrics.json
